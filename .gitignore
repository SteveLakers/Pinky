# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Data (regenerated by pull / feature build)
data/raw/*
!data/raw/.gitkeep
data/features/*
!data/features/.gitkeep
data/labels/*
!data/labels/.gitkeep
data/dataset/*
!data/dataset/.gitkeep
data/universe/*
# Vendor data (license forbids sharing; never commit)
data/sharadar/

# Env / secrets
.env
.env.*
*.pem
credentials*.json

# Model artifacts / secret sauce outputs (not for public GitHub)
models/
artifacts/
*.joblib
*.lgb
*.pkl
*.pickle
!artifacts/.gitkeep
!models/.gitkeep

# OS / IDE
.DS_Store

# Graphify cache (keep rule; graph rebuilds later)
graphify-out/cache/
